{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "hotaru",
  "version": "0.1.13",
  "identifier": "com.hotaru.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5400",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "hotaru",
        "width": 470,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "popover",
        "title": "hotaru",
        "width": 330,
        "height": 430,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "shadow": true,
        "url": "index.html#popover",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kumitaakira453/hotaru/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDQ1ODM1MDE3MEMzMDAKUldRQXczQUJOVmdFZzhpeEJmaTFibUxFd0dyaG9zT1Y1ZEVnN1NKZlJkWGR4dm1HNUdKeVkzckwK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
